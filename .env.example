# The MVP does not require environment variables for its core features.
# Analytics is intentionally enabled only when this variable is set in the
# canonical production deployment.

# 公開URL。既定は https://machi-metrics.tariki-code.tokyo で、
# プレビュー環境など別のURLで配信する場合だけ設定する。
# NEXT_PUBLIC_SITE_URL=https://preview.example.com

# Google Analytics 4 measurement ID.
# Leave this unset for local, preview, and staging deployments.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QJV17LQ46L
